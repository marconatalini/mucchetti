<table class="table datagrid">
    <thead>
    <tr>
        <th scope="col">#</th>
        <th scope="col">dipendente</th>
        <th scope="col">tipo</th>
        <th scope="col">data e ora</th>
        <th></th>
        <th></th>
        <th scope="col">status</th>
        <th scope="col" class="text-end">azioni</th>
    </tr>
    </thead>
    <tbody>
    {% for stamping in stampings %}
        <tr>
            <th>{{ stamping.id }}</th>
            <td>{{ stamping.employee }}</td>
            <td>{{ stamping.stampingType|trans }}</td>
            <td>{{ stamping.missedAt | date('d.m.Y H:i') }}</td>
            <td></td>
            <td></td>
            <td>{{ stamping.status|trans }}</td>
            <td class="text-end">
                {{ include('stamping/_action.html.twig') }}
            </td>
        </tr>
    {% else %}
        {% for i in 1..8 %}
            <tr class="empty-row">
                <td><span></span></td>
                <td><span></span></td>
                <td><span></span></td>
                <td><span></span></td>
                <td><span></span></td>
                <td><span></span></td>
                <td><span></span></td>
                <td><span></span></td>
                <td><span></span></td>
            </tr>
            {% if 4 == loop.index %}
                <tr class="no-result">
                    <td colspan="100" class="text-center">
                        Nessuna dichiarazione
                    </td>
                </tr>
            {% endif %}
        {% endfor %}
    {% endfor %}
    </tbody>
</table>

